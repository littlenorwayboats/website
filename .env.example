# Optional local overrides. Copy this file to .env.local (gitignored).
# Public defaults live in src/lib/config.ts. Do not put secrets in this repo.

# Override the canonical site URL.
# `next dev` defaults to http://localhost:3000.
# `next build` defaults to publicConfig.siteUrl.
# NEXT_PUBLIC_SITE_URL=https://littlenorwayboats.com

# GitHub Pages project-site base path. Set automatically by CI when needed.
# NEXT_PUBLIC_BASE_PATH=
# PAGES_BASE_PATH=
